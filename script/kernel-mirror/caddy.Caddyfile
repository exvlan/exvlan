# EXVlan 内核资产托管（dl.exvlan.era-x.cn/core/）
#
# 目录约定（由 script/kernel-mirror/index.ts 维护；通道化见 docs/decisions-7.3.md §14.13，
# 工具链与 /mirror/trigger 见 docs/mirror-toolchain.md）：
#   /srv/exvlan/core/<channel>/manifest.json
#   /srv/exvlan/core/<channel>/<platform>-v<ver>.zip
#   /srv/exvlan/core/manifest.json                → stable/manifest.json（符号链接）
#   /srv/exvlan/core/mirror-status.json           （同步状态，channels.*）
#   /srv/exvlan/upgrade/<channel>/{latest,manifest,magisk_update}.json + 安装包
#   /srv/exvlan/upgrade/{latest,manifest,magisk_update}.json → stable/…（符号链接）
#   /mirror/trigger                        （反向代理到 trigger-server.ts，POST 触发 / GET 状态）
#
# 说明：
# - 清单与状态必须实时（客户端据此判断是否有更新），因此 no-cache；
#   通道目录与根别名都要覆盖（根上是指向 stable 的符号链接）。
# - zip / 安装包文件名带版本号 → 内容不可变，可长期缓存。
# - 关闭目录浏览，未匹配路径一律 404，避免误暴露服务器上的其它文件。

dl.exvlan.era-x.cn {
	encode zstd gzip

	root * /srv/exvlan

	handle /core/* {
		@manifest path /core/manifest.json /core/*/manifest.json /core/mirror-status.json
		header @manifest Cache-Control "no-cache, must-revalidate"

		@assets path_regexp \.zip$
		header @assets Cache-Control "public, max-age=31536000, immutable"

		header {
			X-Content-Type-Options nosniff
			-Server
		}

		file_server {
			browse false
		}
	}

	# 镜像同步触发端点（docs/mirror-toolchain.md）：
	#   POST → 立刻同步（Header X-Mirror-Token），GET → 最近一次状态
	# trigger 服务只监听回环（127.0.0.1:8899），由这里反代出去；Caddy 不缓存。
	# 注意：`handle` 按声明顺序匹配，必须排在最后那个 `respond 404` 之前。
	handle /mirror/trigger {
		request_body {
			max_size 16KB
		}
		reverse_proxy 127.0.0.1:8899 {
			header_up X-Real-IP {remote_host}
			# 响应头（no-store / nosniff）由 trigger 服务自己带，这里只抹掉上游 Server
			header_down -Server
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	handle /upgrade/* {
		@manifest path /upgrade/manifest.json /upgrade/latest.json /upgrade/magisk_update.json /upgrade/*/manifest.json /upgrade/*/latest.json /upgrade/*/magisk_update.json
		header @manifest Cache-Control "no-cache, must-revalidate"

		@assets path_regexp \.(dmg|msi|exe|apk|gz|zip)$
		header @assets Cache-Control "public, max-age=31536000, immutable"

		header {
			X-Content-Type-Options nosniff
			-Server
		}

		file_server {
			browse false
		}
	}

	respond 404
}
