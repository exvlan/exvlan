# EXVlan 内核资产托管（dl.exvlan.era-x.cn/core/）
#
# 目录约定（由 exvlan-kernel-sync.sh 维护）：
#   /srv/exvlan/core/manifest.json
#   /srv/exvlan/core/<platform>-v<version>.zip
#
# 说明：
# - manifest.json 必须实时（客户端据此判断是否有新内核），因此 no-cache。
# - zip 文件名带版本号 → 内容不可变，可长期缓存。
# - 关闭目录浏览，未匹配路径一律 404，避免误暴露服务器上的其它文件。

dl.exvlan.era-x.cn {
	encode zstd gzip

	root * /srv/exvlan

	handle /core/* {
		@manifest path /core/manifest.json
		header @manifest Cache-Control "no-cache, must-revalidate"

		@assets path_regexp \.zip$
		header @assets Cache-Control "public, max-age=31536000, immutable"

		header {
			X-Content-Type-Options nosniff
			-Server
		}

		file_server {
			browse false
		}
	}

	respond 404
}
