[Unit]
Description=Sync EXVlan kernel assets from GitHub Releases
Documentation=https://github.com/exvlan/exvlan/blob/develop/docs/rules/workflow/kernel-mirror.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=exvlan-mirror
EnvironmentFile=/etc/exvlan-kernel-mirror/env
# 同步实现是 TypeScript（bun）；旧 shell 入口已 legacy，见 docs/mirror-toolchain.md
ExecStart=/usr/bin/env bun /usr/local/lib/exvlan-mirror/index.ts
# 同步脚本只写 /srv/exvlan/core、/srv/exvlan/upgrade 与临时目录
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/exvlan/core /srv/exvlan/upgrade
