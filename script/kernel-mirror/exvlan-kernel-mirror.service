[Unit]
Description=Sync EXVlan kernel assets from GitHub Releases
Documentation=https://github.com/exvlan/exvlan/blob/develop/docs/rules/workflow/kernel-mirror.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=exvlan-mirror
EnvironmentFile=/etc/exvlan-kernel-mirror/env
ExecStart=/usr/local/bin/exvlan-kernel-sync
# 同步脚本只写 /srv/exvlan/core 与临时目录
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/exvlan/core
