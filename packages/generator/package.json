{
  "name": "@exvlan/generator",
  "private": true,
  "version": "26.410.20700",
  "type": "module",
  "scripts": {
    "build:config-wasm": "wasm-pack build ../../exvlan-core --target web --out-dir ../packages/generator/src/generated/config-wasm --out-name exvlan_config --release --no-pack -- --no-default-features --features browser-config",
    "dev": "pnpm build:config-wasm && pnpm --dir ../frontend-lib build && vite",
    "build": "pnpm build:config-wasm && pnpm --dir ../frontend-lib build && vue-tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@primeuix/themes": "^1.2.3",
    "@exvlan/std": "workspace:*",
    "kernelsu": "3.0.2",
    "primevue": "^4.3.9",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "typescript": "~5.6.2",
    "vite": "^5.4.21",
    "vue-tsc": "^2.1.10"
  }
}
