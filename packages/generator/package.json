{
  "name": "@exvlan/generator",
  "version": "26.410.20701",
  "private": true,
  "type": "module",
  "scripts": {
    "build:config-wasm": "wasm-pack build ../../exvlan/core --target web --out-dir ../../packages/generator/src/generated/config-wasm --out-name exvlan_config --release --no-pack -- --no-default-features --features browser-config",
    "dev": "pnpm build:config-wasm && pnpm --dir ../std build && vp",
    "build": "pnpm build:config-wasm && pnpm --dir ../std build && vue-tsc --noEmit && vp build",
    "preview": "vp preview"
  },
  "dependencies": {
    "@exvlan/std": "workspace:*",
    "@primeuix/themes": "^1.2.3",
    "kernelsu": "3.0.2",
    "primevue": "^4.3.9",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "~5.6.3",
    "vite": "catalog:",
    "vue-tsc": "^3.3.9"
  }
}
