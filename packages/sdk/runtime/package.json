{
  "name": "@exvlan/runtime",
  "version": "26.410.20701",
  "description": "Shared WebAssembly runtime for Exvlan web hosts",
  "homepage": "https://github.com/exvlan/exvlan",
  "bugs": "https://github.com/exvlan/exvlan/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exvlan/exvlan.git",
    "directory": "packages/sdk/runtime"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit && pnpm build",
    "test": "vitest run",
    "prepack": "pnpm check"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "binaryen": "131.0.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
