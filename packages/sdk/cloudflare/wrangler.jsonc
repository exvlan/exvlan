{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wasi-relay",
  "main": "example/worker.ts",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ],
  "vars": {
    "EXVLAN_OBJECT_NAME": "primary",
    "EXVLAN_NETWORK_NAME": "cf-wasi",
    "EXVLAN_NETWORK_SECRET": "cf-wasi-test",
    "EXVLAN_ENABLE_ENCRYPTION": "false"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EXVLAN_CORE",
        "class_name": "ExvlanCoreObject"
      }
    ]
  },
  "exports": {
    "ExvlanCoreObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
