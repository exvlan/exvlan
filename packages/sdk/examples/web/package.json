{
  "name": "@exvlan/web-example",
  "version": "26.410.20703",
  "private": true,
  "type": "module",
  "scripts": {
    "build:packages": "pnpm --filter @exvlan/browser build && pnpm --filter @exvlan/cloudflare build",
    "build:browser": "tsc --noEmit -p browser/tsconfig.json && vite build browser",
    "types:cloudflare": "wrangler types cloudflare/worker-configuration.d.ts --config cloudflare/wrangler.jsonc",
    "check:cloudflare": "pnpm types:cloudflare && tsc --noEmit -p cloudflare/tsconfig.json && wrangler deploy --dry-run --config cloudflare/wrangler.jsonc",
    "check": "pnpm build:browser && pnpm check:cloudflare",
    "dev:browser": "vite browser --host 127.0.0.1",
    "dev:cloudflare": "pnpm types:cloudflare && wrangler dev --local --config cloudflare/wrangler.jsonc",
    "deploy:cloudflare": "pnpm types:cloudflare && wrangler deploy --config cloudflare/wrangler.jsonc"
  },
  "dependencies": {
    "@exvlan/browser": "workspace:26.410.20703",
    "@exvlan/cloudflare": "workspace:26.410.20703"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260917.1",
    "@types/node": "22.18.1",
    "typescript": "5.9.3",
    "vite": "^6.4.3",
    "wrangler": "4.134.0"
  }
}
