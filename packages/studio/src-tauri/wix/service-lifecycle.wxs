<?xml version="1.0" encoding="UTF-8"?>
<!--
  EXVlan MSI：特权服务（exvlan-service）的生命周期钩子。

  为什么需要（根因链条与 Windows 手工验证步骤见 docs/windows-service-upgrade.md）
  =============================================================================
  服务不是 MSI 装的：二进制在 C:\ProgramData\era.exvlan.studio\bin\exvlan-service.exe，
  由 GUI 首次运行时提权注册。MSI 完全不知道它，于是大版本升级
  （UpgradeCode 不变 → RemoveExistingProducts）时：
    · 服务及其拉起的 exvlan.exe / exvlan-gateway.exe 仍占着
      C:\Program Files\EXVlan Studio 下的文件 → Restart Manager 报 351、
      RemoveExistingProducts 阶段崩 1601；
    · 升级窗口内服务被文件锁打崩，SCM 三次后放弃拉起（升级后长时间无人善后）。
  因此：装/升级前停服务（连内核与 gateway），文件铺完后再拉起来。

  刻意不做的事
  ============
  · 不创建服务：没有 ServiceInstall。服务二进制在 ProgramData，MSI 不拥有它，
    注册由 GUI 首启自愈负责。
  · 不碰数据目录：C:\ProgramData\era.exvlan.studio 下的配置/日志/内核/token
    在安装、升级、卸载任何路径都不删不移。
  · 不在失败时中断安装：全部 Return="ignore"。停不掉只是回到旧行为（Restart
    Manager 弹「文件正在使用」），不该让整个安装失败。

  时序（对齐 tauri-bundler main.wxs：MajorUpgrade Schedule="afterInstallInitialize"）
  ===============================================================================
  · 停：Before="InstallValidate"。必须早于 InstallValidate，否则 Restart Manager
    的文件占用检查已经报错。带 UI 的安装里，InstallValidate 之前的 action 会先在
    客户端跑一遍、再在服务端（perMachine 为 SYSTEM）重跑；Impersonate="no"
    保证以服务端身份停服务。用 sc / Get-Service，不依赖 exvlan-service 自己的
    命令行面（升级源可能是任意旧版本）。
  · 注销：Before="RemoveFiles"，仅真正卸载时（REMOVE="ALL" AND NOT
    UPGRADINGPRODUCTCODE）。MSI 文档要求依赖 REMOVE=ALL 的动作排在
    InstallValidate 之后。只注销 SCM 项，不删二进制、不删数据。
  · 启：After="InstallFinalize"，仅 NOT REMOVE（安装/升级/修复后都拉起）。
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <!-- 停服务（等 STOPPED），随后清掉孤儿内核/gateway：服务被 SCM 放弃后
             它们仍会占着 Program Files 里的文件。 -->
        <CustomAction Id="ExvlanStopServiceForUpgrade"
                      Directory="INSTALLDIR"
                      Execute="immediate"
                      Impersonate="no"
                      Return="ignore"
                      ExeCommand="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$n='era.exvlan.studio.service'; $s=Get-Service -Name $n -ErrorAction SilentlyContinue; if($s -and $s.Status -ne 'Stopped'){ Stop-Service -Name $n -Force -ErrorAction SilentlyContinue; try{ $s.WaitForStatus('Stopped','00:00:30') }catch{ Write-Output 'exvlan: service stop timeout' } }; Get-Process -Name 'exvlan','exvlan-gateway' -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue; Write-Output 'exvlan: service stopped before upgrade'&quot;" />

        <!-- 装/升级收尾把服务拉回 RUNNING（升级窗口内可能已被 SCM 放弃）。
             服务不存在（用户从没启动过 GUI）时静默跳过。 -->
        <CustomAction Id="ExvlanStartServiceAfterInstall"
                      Directory="INSTALLDIR"
                      Execute="immediate"
                      Impersonate="no"
                      Return="ignore"
                      ExeCommand="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$n='era.exvlan.studio.service'; $s=Get-Service -Name $n -ErrorAction SilentlyContinue; if($s -and $s.Status -ne 'Running'){ Start-Service -Name $n -ErrorAction SilentlyContinue; try{ $s.WaitForStatus('Running','00:00:30') }catch{ Write-Output 'exvlan: service start timeout' } }; Write-Output 'exvlan: service start requested'&quot;" />

        <!-- 真卸载：停 + 注销 SCM 注册。二进制与 ProgramData 数据全部保留，
             重装后由 GUI 首启重新注册。 -->
        <CustomAction Id="ExvlanRemoveServiceOnUninstall"
                      Directory="INSTALLDIR"
                      Execute="immediate"
                      Impersonate="no"
                      Return="ignore"
                      ExeCommand="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$n='era.exvlan.studio.service'; if(Get-Service -Name $n -ErrorAction SilentlyContinue){ &amp; sc.exe stop $n | Out-Null; &amp; sc.exe delete $n | Out-Null }; Write-Output 'exvlan: service unregistered'&quot;" />

        <InstallExecuteSequence>
            <Custom Action="ExvlanStopServiceForUpgrade" Before="InstallValidate">1</Custom>
            <Custom Action="ExvlanRemoveServiceOnUninstall" Before="RemoveFiles"><![CDATA[REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE]]></Custom>
            <Custom Action="ExvlanStartServiceAfterInstall" After="InstallFinalize">NOT REMOVE</Custom>
        </InstallExecuteSequence>
    </Fragment>
</Wix>
