FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    curl \
    wget \
    git \
    build-essential \
    pkg-config \
    libssl-dev \
    libwebkit2gtk-4.0-dev \
    libappindicator3-dev \
    librsvg2-dev \
    patchelf \
    protobuf-compiler \
    openjdk-21-jdk \
    unzip \
    zip \
    file \
    libclang-dev \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64

# 固定 rustup 版本并按官方 archive 的 sha256 校验（替代 `curl sh.rustup.rs | sh`；审计 L2）。
ARG RUSTUP_VERSION=1.28.2
ARG RUSTUP_INIT_SHA256=20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c
RUN set -eux; \
    curl --proto '=https' --tlsv1.2 -fsSL \
      "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu/rustup-init" \
      -o /tmp/rustup-init; \
    echo "${RUSTUP_INIT_SHA256}  /tmp/rustup-init" | sha256sum -c -; \
    chmod +x /tmp/rustup-init; \
    RUSTUP_HOME=/root/.rustup CARGO_HOME=/root/.cargo \
      /tmp/rustup-init -y --no-modify-path --default-toolchain none; \
    rm -f /tmp/rustup-init

ENV PATH="/root/.cargo/bin:${PATH}"

RUN rustup set auto-self-update disable && \
    rustup install 1.93 && \
    rustup default 1.93 && \
    rustup target add aarch64-linux-android && \
    rustup target add armv7-linux-androideabi && \
    rustup target add i686-linux-android && \
    rustup target add x86_64-linux-android

# 固定 Volta 版本并校验发布 tarball 的 sha256（替代 `curl get.volta.sh | bash`；审计 L2）。
ARG VOLTA_VERSION=2.0.2
ARG VOLTA_TARBALL_SHA256=6cec054c911fb925b629a09455775af6e95dc0f5694a4c28b63979ab9ef18037
ENV VOLTA_HOME=/root/.volta
ENV PATH="/root/.volta/bin:${PATH}"
RUN set -eux; \
    curl --proto '=https' --tlsv1.2 -fsSL \
      "https://github.com/volta-cli/volta/releases/download/v${VOLTA_VERSION}/volta-${VOLTA_VERSION}-linux.tar.gz" \
      -o /tmp/volta.tar.gz; \
    echo "${VOLTA_TARBALL_SHA256}  /tmp/volta.tar.gz" | sha256sum -c -; \
    mkdir -p "${VOLTA_HOME}/bin"; \
    tar -xzf /tmp/volta.tar.gz -C "${VOLTA_HOME}/bin"; \
    rm -f /tmp/volta.tar.gz; \
    volta install node@25; \
    volta install pnpm@10; \
    pnpm --version; node --version

ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk

RUN mkdir -p ${ANDROID_HOME}/cmdline-tools /workspace/.cache && \
    cd ${ANDROID_HOME}/cmdline-tools && \
    if [ -f /workspace/.cache/commandlinetools-linux-14742923_latest.zip ]; then \
        echo "Using cached Android cmdline-tools"; \
        cp /workspace/.cache/commandlinetools-linux-14742923_latest.zip .; \
    else \
        echo "Downloading Android cmdline-tools"; \
        wget -q https://dl.google.com/android/repository/commandlinetools-linux-14742923_latest.zip && \
        cp commandlinetools-linux-14742923_latest.zip /workspace/.cache/; \
    fi && \
    unzip commandlinetools-linux-14742923_latest.zip && \
    mv cmdline-tools latest && \
    rm commandlinetools-linux-14742923_latest.zip

ENV PATH="${ANDROID_HOME}/cmdline-tools/latest/bin:${PATH}"

RUN yes | sdkmanager --licenses && \
    sdkmanager "build-tools;36.1.0" \
    "ndk;28.2.13676358" \
    "platform-tools" \
    "platforms;android-36"

ENV NDK_HOME=${ANDROID_HOME}/ndk/28.2.13676358/
ENV PATH="${ANDROID_HOME}/platform-tools:${NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64/bin:${PATH}"

WORKDIR /workspace

CMD ["/bin/bash"]