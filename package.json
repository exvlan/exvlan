{
  "name": "@exvlan/monorepo",
  "private": true,
  "scripts": {
    "deps:latest": "bunx taze latest -r --peer -w",
    "deps:major": "bunx taze major -r --peer -w",
    "deps:prune": "bunx depcheck --json | jq -r '(.dependencies + .devDependencies)[]?' | xargs pnpm remove",
    "postinstall": "pnpm --filter=tauri-plugin-vpnservice-api --filter=@exvlan/std build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@vue/language-core": "^3.3.9",
    "minimatch": "^10.2.6",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  }
}
