{
  "name": "@exvlan/monorepo",
  "private": true,
  "scripts": {
    "deps:latest": "bunx taze latest -r --peer -w",
    "deps:major": "bunx taze major -r --peer -w",
    "deps:prune": "bunx depcheck --json | jq -r '(.dependencies + .devDependencies)[]?' | xargs pnpm remove",
    "postinstall": "pnpm --filter=@exvlan/ipc --filter=@exvlan/kit build"
  },
  "devDependencies": {
    "@vue/language-core": "^3.3.5",
    "minimatch": "^10.2.5"
  }
}
